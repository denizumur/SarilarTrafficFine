@model SarilarTrafficFine.Web.Models.TrafficFines.TrafficFineCreateViewModel

@{
    ViewData["Title"] = "Yeni Trafik Cezası";

    var maximumFineDate =
        DateOnly.FromDateTime(
            DateTime.Now)
        .ToString("yyyy-MM-dd");
}

<div class="fine-form-page">
    <div class="mb-4">
        <a asp-action="Index"
           class="text-decoration-none small">

            <i class="bi bi-arrow-left me-1"></i>
            Trafik cezalarına dön
        </a>

        <h1 class="page-title mt-3">
            Yeni Trafik Cezası
        </h1>

        <p class="page-description">
            Ceza ve araç bilgilerini girerek yeni kayıt oluşturun.
        </p>
    </div>

    <div class="app-surface fine-form-card">
        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="VehicleId"
                           class="form-label">
                    </label>

                    <select asp-for="VehicleId"
                            class="form-select">

                        <option value="">
                            Araç seçiniz
                        </option>

                        @foreach (var vehicle in Model.Vehicles)
                        {
                        <option value="@vehicle.Id">
                            @vehicle.DisplayText
                        </option>
                        }
                    </select>

                    <span asp-validation-for="VehicleId"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FineDate"
                           class="form-label">
                    </label>

                    <input asp-for="FineDate"
                           type="date"
                           max="@maximumFineDate"
                           class="form-control fine-date-input" />

                    <span asp-validation-for="FineDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Amount"
                           class="form-label">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">
                            ₺
                        </span>

                        <input asp-for="Amount"
                               type="number"
                               min="0.01"
                               max="9999999999999999.99"
                               step="0.01"
                               class="form-control fine-money-input"
                               placeholder="0.00" />
                    </div>

                    <span asp-validation-for="Amount"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <div class="fine-form-note">
                        <i class="bi bi-info-circle"></i>

                        <span>
                            Yeni kayıtlar ilk olarak
                            <strong>Yeni</strong>
                            durumunda oluşturulur.
                        </span>
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="Description"
                           class="form-label">

                        Açıklama

                        <span class="text-muted fw-normal">
                            (opsiyonel)
                        </span>
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="Ceza ile ilgili ek açıklama..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="fine-form-actions">
                <a asp-action="Index"
                   class="text-decoration-none">
                    İptal
                </a>

                <button type="submit"
                        class="btn btn-primary px-4">

                    <i class="bi bi-check-lg me-1"></i>
                    Cezayı Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}