@using System.Globalization
@using SarilarTrafficFine.Business.Constants
@using SarilarTrafficFine.Entities.Enums
@model IReadOnlyList<SarilarTrafficFine.Web.Models.TrafficFines.TrafficFineListItemViewModel>

    @{
    ViewData["Title"] = "Trafik Cezaları";

    var tr =
        CultureInfo.GetCultureInfo("tr-TR");
    }

    <div class="page-header">
        <div>
            <h1 class="page-title">
                Trafik Cezaları
            </h1>

            <p class="page-description">
                Trafik cezası kayıtlarını görüntüleyin ve süreçlerini takip edin.
            </p>
        </div>

        @if (User.IsInRole(RoleNames.Operator))
    {
        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Yeni Ceza
        </a>
    }
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert sr-success-alert"
         role="alert">

        <i class="bi bi-check-circle me-1"></i>
        @successMessage
    </div>
}

    @if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger"
         role="alert">

        <i class="bi bi-exclamation-circle me-1"></i>
        @errorMessage
    </div>
}

    <div class="app-surface">
        <div class="fine-toolbar">
            <div class="fine-search">
                <i class="bi bi-search"></i>

                <input type="search"
                       id="fineSearch"
                       class="form-control"
                       placeholder="Plaka, araç veya oluşturan ara..."
                       autocomplete="off" />
            </div>

            <div class="fine-filter">
                <select id="fineStatusFilter"
                        class="form-select">

                    <option value="">
                        Tüm durumlar
                    </option>

                    <option value="@TrafficFineStatus.New">
                        Yeni
                    </option>

                    <option value="@TrafficFineStatus.InApproval">
                        Onayda
                    </option>

                    <option value="@TrafficFineStatus.Completed">
                        Tamamlandı
                    </option>

                    <option value="@TrafficFineStatus.Rejected">
                        Reddedildi
                    </option>
                </select>
            </div>

            <div class="text-muted small ms-lg-auto">
                <strong id="visibleFineCount">
                    @Model.Count
                </strong>
                kayıt
            </div>
        </div>

        @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-receipt"></i>
            </div>

            <h2 class="h5">
                Henüz trafik cezası kaydı bulunmuyor.
            </h2>

            <p class="text-muted">
                Trafik cezası kayıtları burada listelenecek.
            </p>

            @if (User.IsInRole(RoleNames.Operator))
            {
            <a asp-action="Create"
               class="btn btn-primary mt-2">

                İlk Cezayı Ekle
            </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover fine-table mb-0">
                <thead>
                    <tr>
                        <th>Plaka</th>
                        <th>Araç</th>
                        <th>Ceza Tarihi</th>
                        <th class="text-end">Tutar</th>
                        <th>Durum</th>
                        <th>Oluşturan</th>
                    </tr>
                </thead>

                <tbody id="fineRows">
                    @foreach (var fine in Model)
                {
                    <tr class="fine-row"
                        tabindex="0"
                        role="link"
                        data-href="@Url.Action("Details", new { id = fine.Id })"
                        data-search="@($"{fine.PlateNumber} {fine.VehicleName} {fine.CreatedByUserName}")"
                        data-status="@fine.Status">

                        <td>
                            <span class="vehicle-plate">
                                @fine.PlateNumber
                            </span>
                        </td>

                        <td>
                            @fine.VehicleName
                        </td>

                        <td class="fine-date">
                            @fine.FineDate.ToString("dd.MM.yyyy")
                        </td>

                        <td class="text-end fine-money">
                            @fine.Amount.ToString("N2", tr) ₺
                        </td>

                        <td>
                            <span class="sr-status-badge @fine.StatusCssClass">
                                @fine.StatusText
                            </span>
                        </td>

                        <td>
                            @fine.CreatedByUserName
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div id="fineMobileList"
             class="fine-mobile-list d-md-none">

            @foreach (var fine in Model)
            {
            <a asp-action="Details"
               asp-route-id="@fine.Id"
               class="fine-mobile-card"
               data-search="@($"{fine.PlateNumber} {fine.VehicleName} {fine.CreatedByUserName}")"
               data-status="@fine.Status">

                <div class="d-flex justify-content-between gap-3">
                    <span class="vehicle-plate">
                        @fine.PlateNumber
                    </span>

                    <span class="sr-status-badge @fine.StatusCssClass">
                        @fine.StatusText
                    </span>
                </div>

                <div class="fine-mobile-meta">
                    @fine.FineDate.ToString("dd.MM.yyyy")
                    ·
                    <span class="fine-money">
                        @fine.Amount.ToString("N2", tr) ₺
                    </span>
                </div>

                <div class="text-muted small mt-1">
                    @fine.VehicleName
                </div>
            </a>
            }
        </div>

        <div id="fineSearchEmpty"
             class="empty-state d-none">

            <div class="empty-state-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2 class="h6">
                Filtrelerle eşleşen ceza bulunamadı.
            </h2>

            <p class="text-muted mb-0">
                Arama veya durum filtresini değiştirin.
            </p>
        </div>
    }
    </div>

    @section Scripts {
        <script>
    (() => {
        const search =
            document.getElementById("fineSearch");

        const statusFilter =
            document.getElementById("fineStatusFilter");

        const desktopRows =
            [...document.querySelectorAll("#fineRows .fine-row")];

        const mobileCards =
            [...document.querySelectorAll("#fineMobileList .fine-mobile-card")];

        const empty =
            document.getElementById("fineSearchEmpty");

        const count =
            document.getElementById("visibleFineCount");

        const allItems =
            [...desktopRows, ...mobileCards];

        function matches(item, query, status) {
            const searchText =
                (item.dataset.search ?? "")
                    .toLocaleLowerCase("tr-TR");

            const itemStatus =
                item.dataset.status ?? "";

            return searchText.includes(query)
                && (!status || itemStatus === status);
        }

        function applyFilters() {
            const query =
                (search?.value ?? "")
                    .trim()
                    .toLocaleLowerCase("tr-TR");

            const status =
                statusFilter?.value ?? "";

            let desktopVisible = 0;

            desktopRows.forEach(row => {
                const visible =
                    matches(row, query, status);

                row.classList.toggle(
                    "d-none",
                    !visible);

                if (visible) {
                    desktopVisible++;
                }
            });

            mobileCards.forEach(card => {
                const visible =
                    matches(card, query, status);

                card.classList.toggle(
                    "d-none",
                    !visible);
            });

            if (count) {
                count.textContent =
                    desktopVisible.toString();
            }

            empty?.classList.toggle(
                "d-none",
                desktopVisible !== 0);
        }

        search?.addEventListener(
            "input",
            applyFilters);

        statusFilter?.addEventListener(
            "change",
            applyFilters);

        desktopRows.forEach(row => {
            const openDetails = () => {
                const href =
                    row.dataset.href;

                if (href) {
                    window.location.href = href;
                }
            };

            row.addEventListener(
                "click",
                openDetails);

            row.addEventListener(
                "keydown",
                event => {
                    if (
                        event.key === "Enter"
                        || event.key === " "
                    ) {
                        event.preventDefault();
                        openDetails();
                    }
                });
        });
    })();
        </script>
    }
