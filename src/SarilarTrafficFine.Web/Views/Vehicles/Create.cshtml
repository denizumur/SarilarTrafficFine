@model SarilarTrafficFine.Web.Models.Vehicles.VehicleCreateViewModel

@{
    ViewData["Title"] = "Yeni Araç";
}

<div class="form-page">
    <div class="mb-4">
        <a asp-action="Index"
           class="text-decoration-none small">

            <i class="bi bi-arrow-left me-1"></i>
            Araç listesine dön
        </a>

        <h1 class="page-title mt-3">
            Yeni Araç
        </h1>

        <p class="page-description">
            Araç bilgilerini eksiksiz doldurun.
        </p>
    </div>

    <div class="app-surface form-card">
        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="PlateNumber"
                       class="form-label">
                </label>

                <input asp-for="PlateNumber"
                       class="form-control plate-input"
                       placeholder="41 ABC 123"
                       autocomplete="off" />

                <div class="form-help mt-1">
                    Plaka kayıt sırasında normalize edilir.
                </div>

                <span asp-validation-for="PlateNumber"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="VehicleType"
                       class="form-label">
                </label>

                <select asp-for="VehicleType"
                        class="form-select">

                    <option value="">
                        Araç tipi seçiniz
                    </option>

                    @foreach (var option in
                        SarilarTrafficFine.Web.Models.Vehicles.VehicleCreateViewModel.VehicleTypeOptions)
                    {
                    <option value="@((int)option.Value)">
                        @option.Label
                    </option>
                    }
                </select>

                <span asp-validation-for="VehicleType"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand"
                       class="form-label">
                </label>

                <input asp-for="Brand"
                       class="form-control"
                       placeholder="Ford" />

                <span asp-validation-for="Brand"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Model"
                       class="form-label">
                </label>

                <input asp-for="Model"
                       class="form-control"
                       placeholder="Transit" />

                <span asp-validation-for="Model"
                      class="text-danger">
                </span>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-3">
                <a asp-action="Index"
                   class="text-decoration-none">
                    İptal
                </a>

                <button type="submit"
                        class="btn btn-primary px-4">

                    <i class="bi bi-check-lg me-1"></i>
                    Aracı Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const plate =
                document.getElementById("PlateNumber");

            if (!plate) {
                return;
            }

            plate.addEventListener("input", () => {
                plate.value =
                    plate.value.toLocaleUpperCase("tr-TR");
            });

            plate.addEventListener("blur", () => {
                plate.value = plate.value.trim();
            });
        })();
    </script>
}