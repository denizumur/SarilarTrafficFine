@model IReadOnlyList<SarilarTrafficFine.Web.Models.Vehicles.VehicleListItemViewModel>
    @using SarilarTrafficFine.Business.Constants

    @{
    ViewData["Title"] = "Araçlar";
    }

    <div class="page-header">
        <div>
            <h1 class="page-title">
                Araç Yönetimi
            </h1>

            <p class="page-description">
                Sistemde tanýmlý araçlarý görüntüleyin ve yönetin.
            </p>
        </div>

        @if (User.IsInRole(RoleNames.Operator))
    {
        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Yeni Araç
        </a>
    }
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert sr-success-alert"
         role="alert">

        <i class="bi bi-check-circle me-1"></i>
        @successMessage
    </div>
}

    <div class="app-surface">
        <div class="vehicle-toolbar">
            <div class="vehicle-search">
                <i class="bi bi-search"></i>

                <input type="search"
                       id="vehicleSearch"
                       class="form-control"
                       placeholder="Plaka, marka veya model ara..."
                       autocomplete="off" />
            </div>

            <div class="text-muted small">
                <strong>@Model.Count</strong> kayýt
            </div>
        </div>

        @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-truck"></i>
            </div>

            <h2 class="h5">
                Henüz araç eklenmemiþ.
            </h2>

            <p class="text-muted">
                Sisteme tanýmlanan araçlar burada listelenecek.
            </p>

            @if (User.IsInRole(RoleNames.Operator))
            {
            <a asp-action="Create"
               class="btn btn-primary mt-2">

                Ýlk Aracý Ekle
            </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover vehicle-table">
                <thead>
                    <tr>
                        <th>Plaka</th>
                        <th>Tip</th>
                        <th>Marka</th>
                        <th>Model</th>
                    </tr>
                </thead>

                <tbody id="vehicleRows">
                    @foreach (var vehicle in Model)
                {
                    var searchText =
                        $"{vehicle.PlateNumber} {vehicle.Brand} {vehicle.Model}"
                            .ToLowerInvariant();

                    <tr data-search="@searchText">
                        <td>
                            <span class="vehicle-plate">
                                @vehicle.PlateNumber
                            </span>
                        </td>

                        <td>
                            <span class="vehicle-type-badge">
                                @vehicle.VehicleTypeName
                            </span>
                        </td>

                        <td>@vehicle.Brand</td>
                        <td>@vehicle.Model</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div id="vehicleSearchEmpty"
             class="empty-state d-none">

            <div class="empty-state-icon">
                <i class="bi bi-search"></i>
            </div>

            <h2 class="h6">
                Aramanýzla eþleþen araç bulunamadý.
            </h2>

            <p class="text-muted mb-0">
                Farklý bir plaka, marka veya model deneyin.
            </p>
        </div>
    }
    </div>

    @section Scripts {
        <script>
    (() => {
        const search = document.getElementById("vehicleSearch");
        const rowsContainer = document.getElementById("vehicleRows");
        const empty = document.getElementById("vehicleSearchEmpty");

        if (!search || !rowsContainer) {
            return;
        }

        const rows = [...rowsContainer.querySelectorAll("tr")];

        search.addEventListener("input", () => {
            const query = search.value
                .trim()
                .toLocaleLowerCase("tr-TR");

            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.dataset.search ?? "";
                const visible = text.includes(query);

                row.classList.toggle("d-none", !visible);

                if (visible) {
                    visibleCount++;
                }
            });

            empty?.classList.toggle(
                "d-none",
                visibleCount !== 0);
        });
    })();
        </script>
    }
